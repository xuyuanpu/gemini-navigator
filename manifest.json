{
    "manifest_version": 3,
    "name": "Gemini Navigator",
    "version": "1.2.0",
    "description": "为 Gemini 网页版添加对话目录导航、导出和分享功能",
    "permissions": [
        "activeTab",
        "scripting",
        "downloads",
        "clipboardWrite"
    ],
    "host_permissions": [
        "https://gemini.google.com/*",
        "https://*.myqcloud.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://gemini.google.com/*"
            ],
            "js": [
                "lib/pako.min.js",
                "content.js"
            ],
            "css": [
                "styles.css"
            ],
            "run_at": "document_idle"
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}